ROUTER_API_KEY=generate_a_long_random_value
APP_ENV=development
ENABLE_MOCK_FALLBACK=false

GROQ_API_KEY=your_groq_api_key
CEREBRAS_API_KEY=your_cerebras_api_key
PROVIDER_ORDER=["groq_fast","cerebras_primary","groq_reasoning","mock_fallback"]
GROQ_FAST_MODEL=llama-3.1-8b-instant
CEREBRAS_PRIMARY_MODEL=zai-glm-4.7
GROQ_REASONING_MODEL=llama-3.3-70b-versatile

REQUEST_CONNECT_TIMEOUT_SECONDS=3
REQUEST_READ_TIMEOUT_SECONDS=10
REQUEST_WRITE_TIMEOUT_SECONDS=10
REQUEST_POOL_TIMEOUT_SECONDS=3
TOTAL_REQUEST_TIMEOUT_SECONDS=20
MAX_UPSTREAM_RETRY_AFTER_SECONDS=300

CLIENT_RATE_LIMIT_PER_MINUTE=60
MAX_CONCURRENT_REQUESTS=20
MODEL_PRICES_USD_PER_MILLION_TOKENS={}
