ROUTER_API_KEY=generate_a_long_random_value
APP_ENV=development
ENABLE_MOCK_FALLBACK=false

GROQ_API_KEY=your_groq_api_key
CEREBRAS_API_KEY=your_cerebras_api_key
CEREBRAS_ENABLED=false
NVIDIA_ENABLED=true
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_DEFAULT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_ALLOWED_MODELS=["nvidia/nemotron-3.5-lightning-30b-a3b"]
NVIDIA_DEFAULT_MAX_TOKENS=4096
NVIDIA_MAX_OUTPUT_TOKENS=16384
MAX_OUTPUT_TOKENS=16384
# Provider -> requested model -> explicitly permitted upstream identity aliases
PROVIDER_MODEL_ALIASES={}
PROVIDER_ORDER=["groq_fast","nvidia","groq_reasoning","cerebras_primary","mock_fallback"]
GROQ_FAST_MODEL=llama-3.1-8b-instant
CEREBRAS_PRIMARY_MODEL=zai-glm-4.7
GROQ_REASONING_MODEL=llama-3.3-70b-versatile

REQUEST_CONNECT_TIMEOUT_SECONDS=3
REQUEST_READ_TIMEOUT_SECONDS=10
REQUEST_WRITE_TIMEOUT_SECONDS=10
REQUEST_POOL_TIMEOUT_SECONDS=3
TOTAL_REQUEST_TIMEOUT_SECONDS=20
MAX_UPSTREAM_RETRY_AFTER_SECONDS=300

CLIENT_RATE_LIMIT_PER_MINUTE=60
MAX_CONCURRENT_REQUESTS=20
MODEL_PRICES_USD_PER_MILLION_TOKENS={}

# Optional dashboard, configured on the Streamlit server (never in a browser widget).
DASHBOARD_ROUTER_URL=http://127.0.0.1:8000
DASHBOARD_REQUEST_TIMEOUT_SECONDS=30
# Set DASHBOARD_API_KEY in the dashboard secret store when hosted separately.
# If omitted, the dashboard uses the server-side ROUTER_API_KEY above.
